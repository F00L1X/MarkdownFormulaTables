{
    "name": "markdown-formula",
    "displayName": "markdown-formula",
    "description": "Use Excel-like formulas in markdown tables",
    "version": "0.0.6",
    "publisher": "cescript",
    "license": "GPLv3",
    "repository": {
        "url": "https://github.com/cescript/MarkdownFormula"
    },
    "keywords": [
        "markdown",
        "formula",
        "excel"
    ],
    "icon": "logo/logo.png",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:extension.calculate",
        "onLanguage:markdown"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [{
            "command": "extension.calculate",
            "title": "Calculate all formulas"
        }],
        "configuration": {
            "title": "Markdown Formula Settings",
            "properties": {
                "markdown-formula.precisionRounding": {
                    "type": "number",
                    "default": 4,
                    "description": "Rounding precision for floating point numbers"
                },
                "markdown-formula.includeTableHeaderInCellNumaration": {
                    "type": "boolean",
                    "default": false,
                    "description": "Include the header as the first row (1:1) in enumaration"
                },
                "markdown-formula.calculateOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Calculate and update formulas on save (reload required to take effect)"
                },
                "markdown-formula.decimalSeparator": {
                    "type": "string",
                    "default": ".",
                    "enum": [".", ","],
                    "description": "Character to use as decimal separator in numbers"
                },
                "markdown-formula.thousandSeparator": {
                    "type": "string",
                    "default": ",",
                    "enum": [",", ".", " ", ""],
                    "description": "Character to use as thousand separator in numbers"
                },
                "markdown-formula.tableStyles": {
                    "type": "object",
                    "default": {},
                    "description": "Custom styles for tables",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "backgroundColor": {
                                "type": "string",
                                "description": "Background color in CSS format (e.g., '#ff0000' or 'red')"
                            },
                            "textColor": {
                                "type": "string",
                                "description": "Text color in CSS format (e.g., '#000000' or 'black')"
                            }
                        }
                    }
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/vscode": "^1.100.0",
        "@types/glob": "^7.1.3",
        "@types/mocha": "^10.0.6",
        "@types/node": "^16.18.89",
        "eslint": "^8.57.0",
        "@typescript-eslint/eslint-plugin": "^7.2.0",
        "@typescript-eslint/parser": "^7.2.0",
        "glob": "^7.1.7",
        "minimatch": "^3.1.2",
        "mocha": "^10.3.0",
        "typescript": "^5.3.3",
        "@vscode/test-electron": "^2.3.9"
    },
    "dependencies": {
        "hyperformula": "^3.0.0"
    }
}